diff --git a/gcc/config/rs6000/rs6000.opt b/gcc/config/rs6000/rs6000.opt
index e65065f..8bc253d 100644
--- a/gcc/config/rs6000/rs6000.c
+++ b/gcc/config/rs6000/rs6000.c
@@ -3242,7 +3242,7 @@
 bool
 rs6000_legitimate_offset_address_p (enum machine_mode mode, rtx x, int strict)
 {
-  unsigned HOST_WIDE_INT offset, extra;
+  HOST_WIDE_INT offset, extra;
 
   if (GET_CODE (x) != PLUS)
     return false;
@@ -3308,8 +3308,26 @@
       break;
     }
 
-  offset += 0x8000;
-  return (offset < 0x10000) && (offset + extra < 0x10000);
+  /* The displacement of a D-form instruction is a signed 16 bit
+     quantity, so it has to be tested as a signed value.  Tested as an
+     unsigned one, a negative displacement (0xfffff000 for -4096) looks
+     like a huge positive offset and is rejected; the SDK's compiler
+     then computes the address in 64 bits and truncates it to 32 bits
+     (an "addi" and a "clrldi"), where the retail's compiler folds the
+     displacement into the instruction itself.  -mps3-neg-disp selects
+     the retail's behaviour.  */
+  if (ps3_neg_disp)
+    {
+      offset += 0x8000;
+      return (offset >= 0 && offset < 0x10000) && (offset + extra < 0x10000);
+    }
+
+  {
+    unsigned HOST_WIDE_INT uoffset = (unsigned HOST_WIDE_INT) offset;
+
+    uoffset += 0x8000;
+    return (uoffset < 0x10000) && (uoffset + extra < 0x10000);
+  }
 }
 
