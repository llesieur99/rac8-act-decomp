--- a/gcc/config/rs6000/rs6000.h
+++ b/gcc/config/rs6000/rs6000.h
@@ -1866,7 +1866,16 @@
 #define RS6000_PIC_OFFSET_TABLE_REGNUM 30
 #define PIC_OFFSET_TABLE_REGNUM (flag_pic ? RS6000_PIC_OFFSET_TABLE_REGNUM : INVALID_REGNUM)
 
-#define TOC_REGISTER (TARGET_MINIMAL_TOC ? RS6000_PIC_OFFSET_TABLE_REGNUM : 2)
+/* The register the TOC entries are addressed from.  In the minimal TOC
+   mode the SDK's compiler copies the TOC base into r30 and addresses
+   the entries from that copy, so that a TOC entry takes two
+   instructions to read; the retail's compiler addresses them from r2
+   directly, so that one instruction reads them, and r30 stays
+   available for the general purpose registers.  -mps3-toc-direct
+   selects the retail's behaviour.  */
+
+#define TOC_REGISTER ((TARGET_MINIMAL_TOC && ! ps3_toc_direct) \
+		     ? RS6000_PIC_OFFSET_TABLE_REGNUM : 2)
 
 /* Define this macro if the register defined by
    `PIC_OFFSET_TABLE_REGNUM' is clobbered by calls.  Do not define
--- a/gcc/config/rs6000/rs6000.opt
+++ b/gcc/config/rs6000/rs6000.opt
@@ -312,3 +312,16 @@
 mps3-lr-restore-reg=
 Target Var(ps3_lr_restore_reg) Init(0) Joined UInteger
 The general purpose register the epilogue reloads the link register into.
+
+; The retail's compiler reads the entry of the TOC in one instruction, from
+; r2, where the SDK's backend copies the base into r30 and takes two.
+; And it folds a negative displacement into the load, where the D-form's
+; displacement is tested as unsigned and the address is computed in 64 bits
+; then truncated.
+mps3-toc-direct=
+Target Var(ps3_toc_direct) Init(0)
+Read the entry of the TOC in one instruction, from r2.
+
+mps3-neg-disp=
+Target Var(ps3_neg_disp) Init(0)
+Fold a negative displacement into the load.
--- a/gcc/tree-ssa-address.c
+++ b/gcc/tree-ssa-address.c
@@ -225,15 +225,38 @@
     st = NULL_RTX;
 
   if (addr->offset && !integer_zerop (addr->offset))
+    {
 /* CELL LOCAL Begin */
 #ifdef POINTERS_EXTEND_UNSIGNED
-    off = immed_double_const (TREE_INT_CST_LOW (addr->offset),
-			      TREE_INT_CST_HIGH (addr->offset), ptr_mode);
+      enum machine_mode off_mode = ptr_mode;
 #else
-    off = immed_double_const (TREE_INT_CST_LOW (addr->offset),
-			      TREE_INT_CST_HIGH (addr->offset), Pmode);
+/* CELL LOCAL End */
+      enum machine_mode off_mode = Pmode;
 /* CELL LOCAL End */
 #endif /* CELL LOCAL */
+
+      /* The offset is a pointer-sized quantity, and it is signed: build
+	 the constant with the sign it has in that size.  immed_double_const
+	 keeps only the low word of a 64 bit constant, so a negative
+	 offset is read as a huge positive one; the address is then not a
+	 legal one for a D-form instruction, and the compiler computes it
+	 in 64 bits and truncates it.  -mps3-neg-disp selects the retail's
+	 behaviour, which folds the displacement into the instruction.  */
+      int width = TYPE_PRECISION (TREE_TYPE (addr->offset));
+
+      if (ps3_neg_disp && width < GET_MODE_BITSIZE (off_mode))
+	{
+	  HOST_WIDE_INT val = TREE_INT_CST_LOW (addr->offset);
+
+	  val &= ((HOST_WIDE_INT) 1 << width) - 1;
+	  if (val & ((HOST_WIDE_INT) 1 << (width - 1)))
+	    val |= -1 << width;
+	  off = gen_int_mode (val, off_mode);
+	}
+      else
+	off = immed_double_const (TREE_INT_CST_LOW (addr->offset),
+				  TREE_INT_CST_HIGH (addr->offset), off_mode);
+    }
   else
     off = NULL_RTX;
 
